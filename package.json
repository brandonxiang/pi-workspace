{
  "name": "pi-workspace",
  "version": "0.6.2",
  "description": "Local workspace for Pi Agent sessions, dialogue, and terminal work",
  "homepage": "https://pi-workspace.brandonxiang.top",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandonxiang/pi-workspace.git"
  },
  "bin": {
    "pi-workspace": "./bin/pi-workspace.mjs"
  },
  "files": [
    "bin",
    "dist-server",
    "dist",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "type": "module",
  "scripts": {
    "cli": "node bin/pi-workspace.mjs",
    "dev": "node dev.mjs",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "check": "vp check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build:server": "vp pack",
    "build:client": "vp build",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "website:dev": "vp dev --config vite.website.config.ts",
    "website:test": "vp test run --config vite.website.config.ts",
    "website:check": "vp check website vite.website.config.ts",
    "website:build": "tsc -p tsconfig.website.json --noEmit && vp build --config vite.website.config.ts",
    "start": "NODE_ENV=production node dist-server/index.mjs",
    "release": "release-it",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "node-pty": "1.1.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@ant-design/x": "2.9.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.5.3",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "release-it": "21.0.1",
    "remark-gfm": "4.0.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.11.0"
}
